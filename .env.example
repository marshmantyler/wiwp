# --- IMAP Configuration ---
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=soc_triage@yourdomain.com
# Use an App Password, NOT your primary account password
IMAP_PASSWORD=your_app_password_here
# Comma-separated list of folders to poll (useful if filters route to spam)
IMAP_FOLDERS=INBOX,Spam,Junk

# --- Security & Loop Prevention ---
# Drop emails originating from this address to prevent infinite alerting loops (e.g., Wazuh/SIEM alerts)
ALERT_EMAIL_ADDRESS=wazuh@yourdomain.com

# --- Threat Intelligence (VirusTotal) ---
VT_API_KEY=your_virustotal_v3_api_key_here
# Comma-separated list of trusted domains to skip VT lookups (conserves free-tier API quota)
WHITELIST_DOMAINS=google.com,microsoft.com,github.com,apple.com

# --- AI Triage Engine (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
# Recommended: llama-3.3-70b-versatile for fast, accurate JSON generation
GROQ_MODEL=llama-3.3-70b-versatile

# --- Discord ChatOps Configuration ---
# Ensure the bot has the "Message Content Intent" enabled in the Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# The ID of the channel where alerts will be posted (Right-click channel -> Copy ID)
DISCORD_ALERT_CHANNEL_ID=123456789012345678

# --- Daemon Settings ---
# How often the bot polls the mailbox and runs the pipeline (in seconds)
POLL_INTERVAL_SECONDS=30
